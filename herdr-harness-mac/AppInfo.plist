<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Herdr Companion</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Herdr Companion</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>herdr</string>
			</array>
		</dict>
	</array>
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
	<key>HerdrDemoServerURL</key>
	<string>$(HERDR_DEMO_SERVER_URL)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_herdr-harness._tcp</string>
	</array>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to your Herdr server and control your private agent sessions.</string>
	<key>NSMainNibFile</key>
	<string></string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record long-form voice notes to turn into editable Herdr prompts.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Transcribe your recording into an editable prompt when private Parakeet transcription is unavailable.</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>HerdrMacKeychainBackend</key>
	<string>$(HERDR_MAC_KEYCHAIN_BACKEND)</string>
	<key>HerdrKeychainService</key>
	<string>$(HERDR_KEYCHAIN_SERVICE)</string>
	<key>HerdrLegacyKeychainService</key>
	<string>$(HERDR_LEGACY_KEYCHAIN_SERVICE)</string>
	<key>HerdrTerminalBundleIdentifier</key>
	<string>$(HERDR_TERMINAL_BUNDLE_ID)</string>
	<key>HerdrAPNsEnvironment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>SUFeedURL</key>
	<string>$(HERDR_UPDATE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(HERDR_UPDATE_PUBLIC_ED_KEY)</string>
	<key>HerdrUpdateBundleIdentifier</key>
	<string>$(HERDR_UPDATE_BUNDLE_ID)</string>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUSendProfileInfo</key>
	<false/>
	<key>SUScheduledCheckInterval</key>
	<integer>14400</integer>
</dict>
</plist>
